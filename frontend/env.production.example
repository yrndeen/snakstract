# Production Environment Variables for Snakstract
# Copy this file to .env.production and replace values with your actual production settings

# Debug mode (should be false in production)
VITE_DEBUG_MODE=false

# Default network (mainnet for production)
VITE_DEFAULT_NETWORK=mainnet

# Contract address (replace with your deployed contract address)
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Game server URL (replace with your production server URL)
VITE_GAME_SERVER_URL=wss://snakstract.io:2567

# Abstract Mainnet Configuration
VITE_ABSTRACT_MAINNET_CHAIN_ID=2741
VITE_ABSTRACT_MAINNET_RPC=https://api.mainnet.abs.xyz
VITE_ABSTRACT_MAINNET_WS=wss://api.mainnet.abs.xyz/ws
VITE_ABSTRACT_MAINNET_EXPLORER=https://abscan.org/
VITE_ABSTRACT_MAINNET_VERIFY_URL=https://api.abscan.org/api

# Abstract Testnet Configuration (for testing)
VITE_ABSTRACT_TESTNET_CHAIN_ID=11124
VITE_ABSTRACT_TESTNET_RPC=https://api.testnet.abs.xyz
VITE_ABSTRACT_TESTNET_WS=wss://api.testnet.abs.xyz/ws
VITE_ABSTRACT_TESTNET_EXPLORER=https://sepolia.abscan.org/
VITE_ABSTRACT_TESTNET_VERIFY_URL=https://api-sepolia.abscan.org/api

# Localhost Configuration (development only)
VITE_LOCALHOST_CHAIN_ID=31337
VITE_LOCALHOST_RPC=http://127.0.0.1:8545
VITE_LOCALHOST_WS=ws://127.0.0.1:8545
VITE_LOCALHOST_EXPLORER=http://127.0.0.1:8545
VITE_LOCALHOST_VERIFY_URL=http://127.0.0.1:8545 
 