uniform float time;
uniform vec2 resolution;
uniform vec2 effectPosition; // Uniform for the position of the effect
uniform sampler2D uMainSampler; // Scene texture
uniform float discoEffectIntensity; // Intensity of the disco effect

void main(void) {
    // Normalize pixel coordinates
    vec2 uv = gl_FragCoord.xy / resolution.xy;

    // Calculate UV relative to the effect position
    vec2 relativeUV = uv - effectPosition / resolution;

    vec3 color = vec3(0.0);

    // Existing disco effect (colorful patterns)
    float strobe = sin(time * 10.0) * 0.5 + 0.5;
    color.r = sin(relativeUV.x * cos(time) + time);
    color.g = cos(relativeUV.y * sin(time / 2.0) + time / 2.0);
    color.b = sin(relativeUV.x * relativeUV.y * cos(time / 3.0) + time / 3.0);
    color *= strobe;

    // Sample the original color from the scene
    vec4 sceneColor = texture2D(uMainSampler, uv);

    // Blend the disco effect with the scene color based on the intensity
    vec3 finalColor = mix(sceneColor.rgb, color, discoEffectIntensity);

    // Ensure the effect is always semi-transparent
    float maxTransparency = 0.7; // Adjust this value as needed
    float alpha = max(maxTransparency, sceneColor.a);

    gl_FragColor = vec4(finalColor, alpha);
}`,PostFXPipeline$a=Phaser.Renderer.WebGL.Pipelines.PostFXPipeline;class DiscoPipeline extends PostFXPipeline$a{constructor(e0){super({game:e0,renderTarget:!0,fragShader:discoPipelineShader})}onPreRender(){this.set1f("time",this.game.loop.time/1e3),this.set2f("resolution",getGameScene().cameras.main.width,getGameScene().cameras.main.height),this.set1f("discoEffectIntensity",discoEffect.getIntensity());const e0=getScreenPosition(discoEffect.getPosition());this.set2f("effectPosition",e0.x,e0.y)}onDraw(e0,n0){e0.autoClear=!0,e0.setAutoResize(!0),this.bindAndDraw(e0)}}const fragmentLightShader=`
precision mediump float;

#define MAX_LIGHT_SOURCES 50
#define MAX_LINE_GLOWS 50

// Uniforms bound in the onPreRender() method 
// >>> light sources <<< 
uniform vec4 lightTints [MAX_LIGHT_SOURCES];   // In format: [R, G, B, A]
uniform vec3 lightSources [MAX_LIGHT_SOURCES]; // In format: [x, y, radius]
uniform int numLights;
uniform float worldDarknessCoef;
uniform float redTintCoef;

// >>> light outline glows <<< 
uniform int glowsEnabled;
uniform sampler2D uLightMapSampler; 
uniform vec2 lightMapCordsOffset; 
uniform vec2 lightMapSizeRato; 

// wide sampling - reduced for performance
const float WIDE_SAMPLING_THICKNESS = 0.08;
const float WIDE_SAMPLING_COUNT = 4.;

//narrow sampling - reduced for performance
const float NARROW_SAMPLING_THICKNESS = 0.015;
const float NARROW_SAMPLING_COUNT = 3.;

// flickering
const float FLICKER_APLITUDE = 0.1;
const float FLICKER_SPEED = 1.;

// other
uniform float time;

// Taken from scene buffer
uniform sampler2D uMainSampler; 
varying vec2 outTexCoord;

struct Results {
    float lightCoef;
    vec3 tintedColor;
};

/** Adds circular light glows. Takes in the color that should be altered. 
 *  @returns input color altered with circular glow effects.
 */
Results addLights(vec3 inputColor, vec2 fragCord){
    // Collective variable storing level of darkness
    Results res;
    res.lightCoef = 0.0;
    res.tintedColor = inputColor;
    
     // Iterate over all light sources
    for(int i=0; i < MAX_LIGHT_SOURCES ; ++i)
    { 
        if (i >= numLights) break;
		
        // Organize light source data 
      	vec3 lightSource = lightSources[i];
        vec4 tint = lightTints[i];
        float radius = lightSource.z;
        vec2 lightPosition = vec2(lightSource.xy);
    
        // Get position delta
        vec2 delta = fragCord - lightPosition;

        // Calculate squared distance to avoid sqrt (more efficient)
        float distanceSq = delta.x * delta.x + delta.y * delta.y;
        float radiusSq = radius * radius;

        // Adjust collective darkness & tint sampled color
        if (distanceSq < radiusSq){
            float distance = sqrt(distanceSq);
        	// Save darkness coef for later
            res.lightCoef = max(res.lightCoef, 1.0 - distance / radius);
            
            // Tint sampled color
            if (tint.r != -1.0 && tint.g != -1.0 && tint.b != -1.0){
                float tintAlpha = (1.0 - (distance / radius)) * tint.a;
                res.tintedColor = mix(res.tintedColor.rgb, tint.rgb, tintAlpha);
            }
     	}
    }    
    return res;
}

float getFlickerCoefficient() {
    float t = time * FLICKER_SPEED;
    
    float A1 = 0.4;
    float f1 = 1.0; // Frequency of slow pulsing
    float phi1 = 0.0;

    float A2 = 0.2;
    float f2 = 2.5; // Frequency of fast pulsing
    float phi2 = 3.14159 / 3.0; // Phase shift

    float C = 0.6; // Base intensity

    return 1.0 + FLICKER_APLITUDE * (
