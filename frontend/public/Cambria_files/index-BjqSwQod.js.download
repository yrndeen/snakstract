`,document.body.appendChild(this.tipElement);const n0=document.createElement("style");n0.textContent=`
#loader-tip {
  position: fixed;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  text-align: center;
  width: 100%;
}

.tip-card {
  background: rgba(0, 0, 0, 0.65);
  padding: 20px 30px;
  border-radius: 40px;
  max-width: 60%;
  display: inline-block;
  color: #fce5a4;
  font-family: "Inter", sans-serif;
  text-align: center;
  margin: 0 auto;
}

.tip-label {
  font-size: 30px;
  font-weight: 900;
  color: #f0ab21;
  margin-bottom: 8px;
  text-align: left;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8), 
               0 0 6px rgba(240, 171, 33, 0.6); /* shadow + glow */
  letter-spacing: 1px; /* makes it look heavier */
}

.tip-text {
  text-align: left;
  font-size: 30px;
  line-height: 1.4;
  padding-left: 2px;
}
