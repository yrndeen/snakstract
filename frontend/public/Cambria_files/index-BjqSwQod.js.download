           		A2 * sin(2.0 * 3.14159 * f2 * t + phi2) +
           		C
			);
}

float random(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

/**
 * Calculates the initial darkness coefficient based on the provided light map texture.
 * @return The initial darkness coefficient.
 */
Results addGlows(vec3 inputColor) {
    // Initialize variables for light coefficient and total weight
    float totalWeight = 0.0;
    
    vec3 diff = vec3(0.0);
    float light = 0.0;
    
    float randomFloat = random(outTexCoord * time);

    vec2 baseLightMapPos = vec2(lightMapCordsOffset.x + outTexCoord.x * lightMapSizeRato.x, lightMapCordsOffset.y + outTexCoord.y * lightMapSizeRato.y);
    vec4 baseColor = texture2D(uLightMapSampler, baseLightMapPos);
    
    // Early exit if base pixel has significant glow
    if (baseColor.a > 0.9) {
        Results res;
        res.tintedColor = inputColor;
        res.lightCoef = 1.0;
        return res;
    }

    // Iterate over a grid of samples within the outline light thickness
    for (float i = 0.0; i < NARROW_SAMPLING_COUNT; i += 1.0) {
        for (float j = 0.0; j < NARROW_SAMPLING_COUNT; j += 1.0) {
            float dx = (i / NARROW_SAMPLING_COUNT - 0.5) * 2.0 * NARROW_SAMPLING_THICKNESS;
            float dy = (j / NARROW_SAMPLING_COUNT - 0.5) * 2.0 * NARROW_SAMPLING_THICKNESS;            
            
            // Calculate the offset for the current sample
            vec2 offset = vec2(dx, dy) * mix(0.8, 1.0, randomFloat) + randomFloat * 0.01;

            // Sample the light map texture at the offset position
            vec2 screenPos = outTexCoord + offset; 
            vec2 lightMapPos = vec2(lightMapCordsOffset.x + screenPos.x * lightMapSizeRato.x, lightMapCordsOffset.y + screenPos.y * lightMapSizeRato.y);
            vec4 sample = texture2D(uLightMapSampler, lightMapPos);

            // Calculate the weight for the current sample using smoothstep
            float weight = smoothstep(NARROW_SAMPLING_THICKNESS * 1.41, 0.0, length(offset));

            // Accumulate the weighted differences value of the sample
            if( 0.5 < sample.a && sample.a < 0.9){
                float impactCoef = weight * (sample.a - 0.5) * 133.0;
                float colorDifference = distance(baseColor.rgb, sample.rgb);
                if (colorDifference > 0.01) diff += (sample.rgb - inputColor.rgb) * impactCoef;
                light += sample.a * impactCoef;
            }

            // Accumulate the total weight
            totalWeight += weight;
        }
    }
    
    for (float i = 0.0; i < WIDE_SAMPLING_COUNT; i += 1.0) {
        for (float j = 0.0; j < WIDE_SAMPLING_COUNT; j += 1.0) {
            float dx = (i / WIDE_SAMPLING_COUNT - 0.5) * 2.0 * WIDE_SAMPLING_THICKNESS;
            float dy = (j / WIDE_SAMPLING_COUNT - 0.5) * 2.0 * WIDE_SAMPLING_THICKNESS;            
            
            // Calculate the offset for the current sample
            vec2 offset = vec2(dx, dy) * mix(0.8, 1.0, randomFloat) + randomFloat * 0.01;

            // Sample the light map texture at the offset position
            vec2 screenPos = outTexCoord + offset; 
            vec2 lightMapPos = vec2(lightMapCordsOffset.x + screenPos.x * lightMapSizeRato.x, lightMapCordsOffset.y + screenPos.y * lightMapSizeRato.y);
            vec4 sample = texture2D(uLightMapSampler, lightMapPos);

            // Calculate the weight for the current sample using smoothstep
            float weight = smoothstep(WIDE_SAMPLING_THICKNESS * 1.41, 0.0, length(offset));

            // Accumulate the weighted differences value of the sample
            if(sample.a > 0.91){
                float impactCoef = weight * weight;
                diff += (sample.rgb - inputColor.rgb) * impactCoef * 0.4;
                light += sample.a * impactCoef;
            }

            // Accumulate the total weight
            totalWeight += weight;
        }
    }


    float flickerCoef = getFlickerCoefficient();

    Results res;
    res.tintedColor = clamp(inputColor + diff.rgb / totalWeight * 0.7 * flickerCoef, vec3(0.0), vec3(1.0));
    res.lightCoef = clamp(light / totalWeight * 3.0 * flickerCoef, 0.0, 1.0);
    
    return res;
}

/** Calculates distance between line given by starting (a) and ending (b) point and point (p).
 * @returns distance between line and the point
 */
float lineDist(vec2 a, vec2 b, vec2 p) {  
    // Edge case, line is a point
    float l2 = dot(b - a, b - a);
    if(l2 == 0.0) return distance(p, a);
    
    // Get closest point on the line
    float t = clamp(dot(p - a, b - a) / l2, 0., 1.);
    vec2 j = a + t * (b - a);
    
    return distance(p, j);
}


void main() {
    // // Debugging stuff - shows the grid - out of date, need rework before switching on
    // vec2 screenPos = outTexCoord; 
    // vec2 lightMapPos = vec2(lightMapCordsOffset.x + screenPos.x * lightMapSizeRato.x, lightMapCordsOffset.y + screenPos.y * lightMapSizeRato.y);
    
