    `,document.body.appendChild(this.cssLoaderContainer)}injectCSS(){const e0=document.createElement("style");e0.textContent=`
#css-loader {
  position: fixed;
  top: 55%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 500px;
  height: 40px;
  background: #333333;
  border-radius: 2px;
  overflow: hidden;
  padding: 9px;
  color: white;
  font-family: sans-serif;
}

.progress-wrap {
  width: 100%;
  height: 22px;
  background: #999999;
  border-radius: 2px;
  overflow: hidden;
}

.progress-bar {
  height: 22px;
  background: #F0AB21;
  transform-origin: left center;
  transform: scaleX(0);
  animation: grow ${STATIC_MAP_PROGRES_DURATION}s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  will-change: transform;
  border-radius: 2px;
}

@keyframes grow {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

