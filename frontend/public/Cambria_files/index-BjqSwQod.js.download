precision mediump float;

// Uniforms bound in the Pipeline.onPreRender()
uniform vec4 tint; // tint of the outline
// uniform float thickness; // thickness of the outline

// Taken from scene buffer
varying vec2 outTexCoord;
uniform sampler2D uMainSampler; // the uv-map texture
uniform sampler2D lutSampler; // the lut

// Constants
const float thickness = 0.02;
const float sampling = 10.;

bool isShadow(vec4 color){
    return color.r == color.g && color.g == color.b && color.g != 0.0;
}

void main() {
    // Sampling current color
    vec4 sampledColor = texture2D(uMainSampler, outTexCoord);
    
    // Check if sampled color is part of the texture and is not a shadow
    if (sampledColor.a > 0.0) {
        gl_FragColor = sampledColor;
        return;
    }
    
    // Calculate blur strength
    float blurCoef = 0.0;
    float totalWeight = 0.0;
    float maxDist = 1.41 * thickness;
    for (float dx = -thickness; dx <= thickness; dx += thickness / sampling) {
        for (float dy = -thickness; dy <= thickness; dy += thickness / sampling) {
            vec2 offset = vec2(dx, dy);
            vec4 sample = texture2D(uMainSampler, outTexCoord + offset);
            float weight = smoothstep(maxDist, 0.0, length(offset));
            blurCoef += sample.a * weight;
            totalWeight += weight;
        }
    }
    blurCoef /= totalWeight;
    
    // Mix the original color and the blurred color based on the blur amount
    vec4 finalColor = mix(sampledColor, tint, blurCoef * 1.5);
    
    // Output the final color
    gl_FragColor = finalColor;
}
