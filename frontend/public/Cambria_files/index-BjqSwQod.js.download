precision mediump float;

varying vec2 outTexCoord;
uniform sampler2D uMainSampler;
uniform vec2 velocity;

const float blurAmount = 0.008;  // Scale of the blur based on velocity
const int blurSamples = 10;     // Number of blur samples

bool isWithinTheTexture(vec4 color){
    return color.r + color.g + color.b + color.a != 0.0;
}

void main()
{
    // Scale velocity for the blur effect
    vec2 effectiveVelocity = velocity.xy * blurAmount;
    vec4 color = texture2D(uMainSampler, outTexCoord);

    // Blur only the surrounding of the texture
    if (isWithinTheTexture(color)){
        gl_FragColor = color;
        return;
    }

    // Accumulate texture samples along the motion direction
    for (int i = 1; i < blurSamples + 1; ++i)
    {
        float t = float(i) / float(blurSamples - 1);
        vec2 offset = effectiveVelocity * t;
        color += texture2D(uMainSampler, outTexCoord + offset);
    }

    // Average the accumulated color
    gl_FragColor = color / float(blurSamples);
}
