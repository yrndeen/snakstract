    //     gl_FragColor = mix(sC, lightColor, 0.6);
    //     return;
    // } 

    // Sampling current color
    vec4 sampledColor = texture2D(uMainSampler, outTexCoord);
    
    // Add circular lights and tints
    Results lightResults = addLights(sampledColor.rgb, gl_FragCoord.xy);

    Results res;
    if (glowsEnabled == 1){	
        // Add surface lights and tints - as input color provide tinted color from light caluclations
        Results glowResults = addGlows(lightResults.tintedColor);
           
        // Combine light and glow results
        res.lightCoef =  max(lightResults.lightCoef, glowResults.lightCoef); 
        res.tintedColor = glowResults.tintedColor;
    } else {
        // Apply only light glows
        res = lightResults;
    }

    // Darken the color by worldDarknessCoef
    vec3 darkenedColor = mix(res.tintedColor, vec3(0.0), worldDarknessCoef);

    // Transition between darkened color and original(or tinted) color based on darknessCoef
    vec3 glowedColor = mix(darkenedColor, res.tintedColor, res.lightCoef);
    
    // Tint the color red
    vec3 redTintedColor = mix(glowedColor, vec3(1.0, 0.0, 0.0), redTintCoef);

    gl_FragColor = vec4(redTintedColor, sampledColor.a);
}
