precision mediump float;

varying vec2 outTexCoord;
uniform sampler2D uMainSampler; 
uniform sampler2D uPalette;
uniform float shaderAlpha;


bool isBlack(vec4 color){
    return color.r + color.g + color.b == 0.0;
}

bool isWhite(vec4 color){
    return color.r + color.g + color.b == 3.0;
}

bool isOutsideOfTheTexture(vec4 color){
    return color.a == 0.0;
}

float getSamplingOffset(vec4 baseColor) {
    if (isBlack(baseColor)){
        // Map black to black (0.0 effectively maps it back to black, both 0.0 and 1.0 are outside of the texture in glsl)
        return 0.0;
    } else if (isWhite(baseColor)) {
        // Map white to last color on the palette, 1.0 goes out of range 
        return 0.99;
    } else {
        // Calculate offset based on red color component
        return baseColor.r;
    }
}

void main() {
    // Sample color from the base texture [texture2D takes position as a value 0.0 - 1.0 relative to top left corner]
    vec4 baseColor = texture2D(uMainSampler, outTexCoord);

    // Don't map colors outside of the texture 
    if (isOutsideOfTheTexture(baseColor)){
        gl_FragColor = baseColor;
        return;
    }
    
    // Get sampling offset
    float samplingOffset = getSamplingOffset(baseColor);
    
    // Sample output color from palette
    vec4 paletteColor = texture2D(uPalette, vec2(samplingOffset, 0.0));

    // Assign output color
    gl_FragColor = vec4(paletteColor.r, paletteColor.g, paletteColor.b, min(shaderAlpha, paletteColor.a));
}

