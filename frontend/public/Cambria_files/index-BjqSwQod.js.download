precision mediump float;

#extension GL_OES_standard_derivatives : enable

#define NUM_OCTAVES 8

uniform float time;
uniform vec2 resolution;
uniform vec4 fogArea;
uniform sampler2D uMainSampler;
varying vec2 outTexCoord;

mat3 rotX(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat3(
        0.5, 0, 0,
        0, c, -s,
        0, s, c
    );
}
mat3 rotY(float a) {
    float c = cos(a);
    float s = sin(a);
    return mat3(
        c, 0, -s,
        0, 1, 0,
        s, 0, c
    );
}

float random(vec2 pos) {
    return fract(sin(dot(pos.xy, vec2(1399.9898, 78.233))) * 43758.5453123);
}

// Combines random values at nearby positions to create a smooth noise pattern.
float noise(vec2 pos) {
    vec2 i = floor(pos);
    vec2 f = fract(pos);
    float a = random(i + vec2(0.0, 0.0));
    float b = random(i + vec2(1.0, 0.0));
    float c = random(i + vec2(0.0, 1.0));
    float d = random(i + vec2(1.0, 1.0));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}


// Uses multiple octaves of the noise function to create a fractal or Perlin noise effect.
float fbm(vec2 pos) {
    float v = 0.0;
    float a = 0.5;
    vec2 shift = vec2(100.0);
    mat2 rot = mat2(cos(0.5), sin(0.5), -sin(0.5), cos(0.5));
    for (int i=0; i<NUM_OCTAVES; i++) {
        v += a * noise(pos);
        pos = rot * pos * 2.0 + shift;
        a *= 0.5;
    }
    return v;
}

bool isInsideRectangle(vec2 point, vec4 rect) {
    vec2 rectMin = rect.xy;
    vec2 rectMax = rect.xy + rect.zw;
    return all(greaterThanEqual(point, rectMin)) && all(lessThanEqual(point, rectMax));
}

void main(void) {
    vec4 sampledColor = texture2D(uMainSampler, outTexCoord); 

    // Check if our current fragment is inside the desired effect area
    if (!isInsideRectangle(gl_FragCoord.xy, fogArea)){
        // gl_FragColor = vec4(1.0,1.0,1.0,1.0);
        gl_FragColor = sampledColor;
        return;
    }

    vec2 relativePosition = gl_FragCoord.xy - fogArea.xy;
    float scaledTime = 0.7 * time;    // scaling time

    vec2 p = (relativePosition.xy * 1.0 - resolution.xy) / 100.0;

    vec2 q = vec2(0.0);
    q.x = fbm(p + 0.30 * scaledTime);
    q.y = fbm(p + vec2(1.0));
    vec2 r = vec2(0.0);
    r.x = fbm(p + 1.0 * q + vec2(1.2, 3.2) + 0.135 * scaledTime);
    r.y = fbm(p + 1.0 * q + vec2(8.8, 2.8) + 0.126 * scaledTime);

    float fogAmount = clamp(length(r.x) * 0.3, 0.0, 1.0); // reduce intensity
    vec3 fogColor = vec3(0.85); 
    vec3 color = mix(sampledColor.rgb, fogColor, fogAmount * 0.4);


    // gl_FragColor = vec4(mix(sampledColor.rgb, color, 0.2), sampledColor.a);
    gl_FragColor = vec4(color, 1.0);
}
